# auto-researcher: never back up private/runtime files
.manager/
.runtime/
*.sock
repos/
workspace/beat-stockfish/
__pycache__/
*.pyc
_site/

# Render-check screenshots from report development. Scratch: no report or doc
# ever references one (report charts are drawn in the browser, not embedded),
# and they had grown to 11 MB across 7 analysis dirs. `git add -f` if you ever
# genuinely need to commit one.
analysis/**/*.png
app/*.png

# The live env's scratch dir. Its one keeper, the kit totals-whisker smoke test,
# now lives in scripts/small-smokes/kit-totals/; everything else there is
# throwaway and should not come back on the next sync.
tmp/

# Smoke-test build output (fixture page + its screenshots).
scripts/small-smokes/**/_out/
